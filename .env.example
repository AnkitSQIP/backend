# ── IPWatch Backend — Production Environment Variables ─────────────────────────
# Copy this file to .env and fill in real values.
# On Koyeb: set these as environment variables in the Koyeb dashboard (no .env file needed).

# Neon PostgreSQL connection string (from Neon dashboard → Connection Details → asyncpg)
# Format: postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Neon PostgreSQL connection string (asyncpg format — get from Neon dashboard)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-use-a-long-random-string-at-least-32-chars

# OpenRouter API key — from openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# CORS origins — set to your Vercel frontend URL (no trailing slash)
# Multiple origins: comma-separated e.g. "https://your-app.vercel.app,https://custom-domain.com"
CORS_ORIGINS=https://your-app.vercel.app
